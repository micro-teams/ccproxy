<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>app.microteams</groupId>
    <artifactId>ccproxy-origin</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>ccproxy-origin</name>
    <description>The MultiPath origin for ccproxy: terminates the substrate, splices to the backend's existing MITM proxy port (3128) — no protocol change, just a transport swap.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <kotlin.version>2.4.10</kotlin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- MultiPath is published to GitHub Packages. This module is the only thing in the repo that
         needs a token to build, so it stays its own module rather than a dependency bolted onto
         backend (mirrors micro-teams' origin/pom.xml). -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/micro-teams/multipath</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>app.microteams</groupId>
            <artifactId>multipath</artifactId>
            <version>0.2.0-rc.4</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!-- One self-contained jar: runs in a bare JRE image with nothing else mounted beside
                 it, exactly like backend.jar does. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>app.microteams.ccproxy.origin.MainKt</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
