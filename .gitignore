# transient agent worktrees
.claude/worktrees/

# deploy runtime state + secrets (created by deploy/gen-env.sh)
deploy/.env
deploy/app_data/

# frontend
frontend/node_modules/
frontend/dist/

# backend/origin build output
backend/target/
origin/target/
origin/dependency-reduced-pom.xml

# python bytecode
__pycache__/
*.pyc

# generated at build time from entity metadata (shipped in the bundle, not versioned)
backend/CREATE.sql

# a stray local `go build ./...` (windows cross-compile, or plain) with no -o lands one of these
# in connector/ — never a real, intentional artifact
connector/connector
connector/connector.exe
